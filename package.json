{
  "name": "cyber-actor-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "export:data": "node scripts/export-dataset.mjs",
    "validate:data": "node scripts/validate-dataset.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "check": "npm run validate:data && npm run lint && npm test",
    "build": "npm run export:data && npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.2.2"
  }
}
